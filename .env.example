# --- Vultr Serverless Inference (mandatory) ---
VULTR_INFERENCE_API_KEY=your_vultr_inference_key
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash

# --- Sandbox containment ---
# docker  : one hardened container per task (production, on the Vultr VM)
SANDBOX_DRIVER=docker
SANDBOX_IMAGE=brz-sandbox:latest
# Use gVisor (runsc) if installed on the host. Falls back to runc with a warning.
SANDBOX_RUNTIME=runsc
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS=128
SANDBOX_WORKSPACE_MB=64
SANDBOX_CMD_TIMEOUT_S=60
SANDBOX_TASK_TTL_S=600
SANDBOX_NETWORK=none

# --- Agent ---
AGENT_MAX_STEPS=6
AGENT_MAX_ACTIONS_PER_STEP=8

# --- Web ---
PORT=8080
